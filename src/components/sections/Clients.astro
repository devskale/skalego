---
// Clients belt — marquee of customer logos. Belt paused on hover (layout.css).
// href optional — only linked clients get an <a> wrapper
const logos = [
  { src: '/sylents.png', alt: 'sylents', dark: true, w: 300, h: 88 },
  { src: '/wwhb.png', alt: 'Wiener Wohnen Hausbetreuung', dark: true, href: 'https://www.hausbetreuung-wien.at/', w: 300, h: 75 },
  { src: '/meduni.png', alt: 'MedUni Wien', dark: true, w: 886, h: 214 },
  { src: '/gwenenergiespeicher.png', alt: 'gwen energiespeicher', dark: false, w: 248, h: 78 },
  { src: '/Vectacore.png', alt: 'Vectacore', dark: true, w: 500, h: 123 },
];
---

<section id="clients" class="clients-bar">
  <p class="belt-label reveal">Im Einsatz bei</p>
  <div class="belt-mask">
    <div class="belt-track">
      <div class="belt-copy">
        {logos.map((l) =>
          l.href ? (
            <a href={l.href} target="_blank" rel="noopener">
              <img src={l.src} alt={l.alt} width={l.w} height={l.h} class={`belt-logo ${l.dark ? 'belt-logo-dark' : ''}`} loading="lazy" />
            </a>
          ) : (
            <img src={l.src} alt={l.alt} width={l.w} height={l.h} class={`belt-logo ${l.dark ? 'belt-logo-dark' : ''}`} loading="lazy" />
          )
        )}
      </div>
      <div class="belt-copy" aria-hidden="true">
        {logos.map((l) =>
          l.href ? (
            <a href={l.href} tabindex="-1" aria-hidden="true">
              <img src={l.src} alt="" width={l.w} height={l.h} class={`belt-logo ${l.dark ? 'belt-logo-dark' : ''}`} loading="lazy" />
            </a>
          ) : (
            <img src={l.src} alt="" width={l.w} height={l.h} class={`belt-logo ${l.dark ? 'belt-logo-dark' : ''}`} loading="lazy" />
          )
        )}
      </div>
    </div>
  </div>
</section>
