---
// Hero — particle canvas + headline. Canvas id drives site.js.
---

<section id="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-content">
    <div class="hero-badge reveal">AI Engineering</div>
    <h1 class="hero-title reveal">
      AI Engineering: Wir machen <span class="accent">KI</span> produktiv.
    </h1>
    <p class="hero-sub reveal">
      Maßgeschneiderte KI-Systeme für Unternehmen — LLM-Integration, RAG
      und autonome Agenten, lokal und on-premise betrieben. Ihre Daten bleiben,
      wo sie sind. Ihre Agenten arbeiten bei Ihnen.
    </p>
    <div class="hero-actions reveal">
      <a href="/#contact" class="btn btn-primary btn-lg">Erstgespräch vereinbaren</a>
      <a href="/ai-engineering/" class="btn btn-outline">Was ist AI Engineering?</a>
    </div>
    <div class="hero-feed reveal" aria-hidden="true">
      <div class="feed-head">
        <span class="feed-dot" aria-hidden="true"></span>
        <span class="feed-title">Live · Agenten im Einsatz</span>
      </div>
      <ol class="feed-list" id="hero-feed">
        <div class="feed-track">
          <li class="feed-item"><span class="feed-actor">RAG-Agent</span><span class="feed-action">analysiert 12 Dokumente</span></li>
          <li class="feed-item"><span class="feed-actor">Deploy-Agent</span><span class="feed-action">veröffentlicht Update auf Skale-CDN</span></li>
          <li class="feed-item"><span class="feed-actor">Embedding-Job</span><span class="feed-action">Index aktualisiert (1.240 neue Chunks)</span></li>
          <li class="feed-item"><span class="feed-actor">Review-Agent</span><span class="feed-action">prüft Änderung · 3 Kommentare</span></li>
          <li class="feed-item"><span class="feed-actor">Agent-Team</span><span class="feed-action">beantwortet Support-Ticket in 42s</span></li>
          <li class="feed-item" aria-hidden="true"><span class="feed-actor">RAG-Agent</span><span class="feed-action">analysiert 12 Dokumente</span></li>
          <li class="feed-item" aria-hidden="true"><span class="feed-actor">Deploy-Agent</span><span class="feed-action">veröffentlicht Update auf Skale-CDN</span></li>
          <li class="feed-item" aria-hidden="true"><span class="feed-actor">Embedding-Job</span><span class="feed-action">Index aktualisiert (1.240 neue Chunks)</span></li>
          <li class="feed-item" aria-hidden="true"><span class="feed-actor">Review-Agent</span><span class="feed-action">prüft Änderung · 3 Kommentare</span></li>
          <li class="feed-item" aria-hidden="true"><span class="feed-actor">Agent-Team</span><span class="feed-action">beantwortet Support-Ticket in 42s</span></li>
        </div>
      </ol>
    </div>
  </div>
</section>
