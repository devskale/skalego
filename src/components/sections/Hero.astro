---
// Hero — particle canvas + headline. Canvas id drives site.js.
---

<section id="hero">
  <div class="hero-glow" aria-hidden="true"></div>
  <canvas id="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-content">
    <div class="hero-badge reveal">AI Engineering</div>
    <h1 class="hero-title reveal">
      AI Engineering: Wir machen <span class="accent">KI</span> produktiv.
    </h1>
    <p class="hero-sub reveal">
      Maßgeschneiderte KI-Systeme für Unternehmen — LLM-Integration, RAG
      und autonome Agenten, lokal und on-premise betrieben. Ihre Daten bleiben,
      wo sie sind. Ihre Agenten arbeiten bei Ihnen.
    </p>
    <div class="hero-actions reveal">
      <a href="/#contact" class="btn btn-primary btn-lg">Erstgespräch vereinbaren</a>
      <a href="/ai-engineering/" class="btn btn-outline">Was ist AI Engineering?</a>
    </div>
    <div class="hero-feed reveal" aria-hidden="true">
      <div class="feed-head">
        <span class="feed-dot" aria-hidden="true"></span>
        <span class="feed-title">Live · Agenten im Einsatz</span>
        <span class="feed-clock" id="feed-clock"></span>
      </div>
      <!-- icons: lucide-static v1.47.0 (ISC), inlined -->
      <div class="feed-list" id="hero-feed">
        <div class="feed-track">
          <div class="feed-item">
            <span class="feed-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"/><path d="M14 2v5a1 1 0 0 0 1 1h5"/><circle cx="11.5" cy="14.5" r="2.5"/><path d="M13.3 16.3 15 18"/></svg></span>
            <span class="feed-actor">RAG-Agent</span>
            <span class="feed-action">analysiert 12 Verträge</span>
            <span class="feed-time">vor 6 s</span>
          </div>
          <div class="feed-item">
            <span class="feed-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"/><path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"/><path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"/></svg></span>
            <span class="feed-actor">Embedding-Job</span>
            <span class="feed-action">Index aktualisiert · 1.240 neue Chunks</span>
            <span class="feed-time">vor 21 s</span>
          </div>
          <div class="feed-item">
            <span class="feed-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/></svg></span>
            <span class="feed-actor">Agent-Team</span>
            <span class="feed-action">Ticket #4812 gelöst · 37 s</span>
            <span class="feed-time">vor 44 s</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
