---
// Agentic Coding — skale-skills als offenes Paket, featured auf der Startseite.
// Die Skill-Liste kommt aus der Registry-SSOT (recommended-skills frontmatter,
// gleiche Quelle wie /skills/), damit nichts driftet.
//
// Der Hairline-Teaser ist ein selbstständiges Skill-Artefakt
// (public/hairline/agents.html — Kernel: hairline von Lucas Marques, MIT),
// lazy per iframe eingebettet. Es bringt eigene Controls mit
// (Intensitäts-Slider, Theme-Schalter, Read-out) und läuft ohne JS dieser Seite.
import { getCollection } from 'astro:content';

const all = await getCollection('blog', ({ data }) => (import.meta.env.PROD ? data.draft !== true : true));
const entry = all.find((p) => Array.isArray(p.data.skills) && p.data.skills.length);
const skills = (entry?.data.skills ?? []).filter((s) => !s.hidden);

// Where a skill installs, derived from the install format (mirror of the
// envLabel helper on /skills/).
function envLabel(s: { install: string }): string | null {
  const inst = String(s.install || '');
  if (inst === 'pi-skill' || inst.startsWith('pi-skillset:')) return 'pi';
  if (inst.includes('skills@latest')) return '.agents/skills';
  if (inst.includes('impeccable')) return '.agents';
  return null;
}

const install = 'pi install git:github.com/devskale/skale-skills';
---

<section id="agentic">
  <div class="container">
    <header class="section-head reveal">
      <h2 class="section-title">Agentic Coding.</h2>
      <p class="section-sub">
        Agentic Engineering ist unser Kern: Wir entwickeln Skills und
        Extensions für Coding-Agenten und bringen sie in Ihren
        Entwicklungsalltag. Was dabei entsteht, fließt in ein offenes
        Paket zurück.
      </p>
      <div class="agentic-stack reveal">
        <span class="agentic-stack-label">Stack</span>
        <a class="agentic-stack-item" href="https://pi.dev" target="_blank" rel="noopener"><strong>pi</strong> pi.dev</a>
        <span class="agentic-stack-plus" aria-hidden="true">+</span>
        <a class="agentic-stack-item" href="https://herdr.dev" target="_blank" rel="noopener"><strong>Herdr</strong> herdr.dev</a>
        <span class="agentic-stack-note">der Coding-Agent und die Runtime, auf der er läuft</span>
      </div>
    </header>

    <!-- HAIRLINE FIGURE — self-contained skill artifact (public/hairline/agents.html), embedded lazy -->
    <div class="agentic-teaser reveal">
      <div class="agentic-teaser-head">
        <span class="agentic-teaser-kicker">Agentic Visual Skills</span>
        <span class="agentic-teaser-hint">Bewege den Zeiger über das Feld &mdash; die Figur antwortet.</span>
      </div>
      <div class="agentic-stage">
        <iframe
          src="/hairline/agents.html?theme=dark"
          title="Hairline-Figur »agents«: ein 3x3-Feld aus Agenten-Würfeln. Der Agent unter dem Zeiger hebt ab, seine Nachbarn steigen versetzt mit."
          loading="lazy"></iframe>
      </div>
      <p class="agentic-teaser-note">
        Visualisierungs-Skills: diese Hairline-Figur &mdash; Kernel:
        <a href="https://hairline.lucasmarkes.com" target="_blank" rel="noopener">hairline</a> (MIT, &copy; Lucas Marques) &mdash;
        und <a href="https://github.com/devskale/skale-skills" target="_blank" rel="noopener">visualize</a>,
        das aus einer Anfrage eine self-contained HTML mit teilbarer URL baut.
      </p>
    </div>

    <div class="agentic-split">
      <article class="agentic-repo reveal">
        <span class="agentic-dev-kicker">Entwicklung</span>
        <h3 class="agentic-dev-title">Skill- &amp; Extension-Entwicklung</h3>
        <p class="agentic-repo-desc">
          Eigene Skills und pi-Extensions für Ihren Agenten-Stack,
          abgestimmt auf Codebasis und Prozesse. Beispiel: unser
          offenes Paket
        </p>
        <ul class="agentic-dev-list">
          <li><strong>Skill-Entwicklung</strong><span>SKILL.md nach agentskills.io-Format</span></li>
          <li><strong>Extension-Entwicklung</strong><span>pi-Extensions mit TypeBox-Schema</span></li>
        </ul>
        <a class="agentic-repo-name" href="https://github.com/devskale/skale-skills" target="_blank" rel="noopener">
          devskale<span>/skale-skills</span>
        </a>
        <div class="install-box">
          <code>{install}</code>
          <button class="copy" type="button" data-copy={install} aria-label="Install-Befehl kopieren">
            <svg class="icon-clip" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="11" height="11" rx="2"/><path d="M5 15V5a2 2 0 0 1 2-2h10"/></svg>
            <svg class="icon-check" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          </button>
        </div>
        <a class="agentic-repo-more" href="/agent-coding/">Alle Guides und Details <span aria-hidden="true">→</span></a>
      </article>

      <div class="agentic-skills reveal">
        <ul class="agentic-skill-list">
          {skills.map((s) => {
            const env = envLabel(s);
            return (
              <li class="agentic-skill">
                <span class="agentic-skill-name">
                  {s.slug}
                  {env && <span class="agentic-skill-env">{env}</span>}
                </span>
                <span class="agentic-skill-desc">{s.desc}</span>
              </li>
            );
          })}
        </ul>
        <div class="agentic-skills-foot">
          <a href="/skills/">Alle Skills ansehen <span aria-hidden="true">→</span></a>
          <span class="agentic-skill-count">{skills.length} Skills, je ein Einzeiler-Install</span>
        </div>
        <p class="agentic-skills-ref">
          Referenz für Skill-Design: die Familie von <a
            href="https://github.com/mattpocock/skills" target="_blank" rel="noopener">@mattpocock</a> (improve-architecture,
            implement), in dieser Liste enthalten.
        </p>
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    /* copy button (dev card) */
    document.querySelectorAll('.agentic-repo .copy').forEach(function (b) {
      b.addEventListener('click', function () {
        var text = b.getAttribute('data-copy') || '';
        var done = function () {
          b.classList.add('copied');
          setTimeout(function () { b.classList.remove('copied'); }, 1400);
        };
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(text).then(done, done);
        } else {
          var ta = document.createElement('textarea');
          ta.value = text; ta.style.position = 'fixed'; ta.style.opacity = '0';
          document.body.appendChild(ta); ta.select();
          try { document.execCommand('copy'); } catch (e) { /* ignore */ }
          document.body.removeChild(ta); done();
        }
      });
    });
  })();
</script>
