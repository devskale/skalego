---
import BaseLayout from '@layouts/BaseLayout.astro';

// AI-Engineering-Landingpage (2026-09-19): Keyword-Fokus "AI Engineering" /
// "KI-Entwicklung" — GSC 90d zeigte "artificial intelligence consulting" auf
// pos 27,5 und die Marke schwach auf Seite 1. Die Seite trägt die Suchintention
// komplett (Definition, Leistungen, Stack, Prozess, FAQ) und wird über Nav,
// Footer, Startseiten-Hero/Services und /agent-coding/ intern verlinkt.
// FAQ nur sichtbar — FAQPage-JSON-LD bringt seit Mai 2026 keine Rich-Results
// mehr (seoguide); Breadcrumb + Service-JSON-LD bleiben wirksam.

const title = 'AI Engineering für Unternehmen – On-Premise & Cloud | Skale';
const description = 'AI Engineering von Skale: maßgeschneiderte KI-Systeme — LLM-Integration, RAG, Agenten und on-premise-Betrieb. Von der Idee bis zur produktionsreifen Pipeline.';

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://skale.dev/' },
        { '@type': 'ListItem', position: 2, name: 'AI Engineering', item: 'https://skale.dev/ai-engineering/' },
      ],
    },
    {
      '@type': 'Service',
      name: 'AI Engineering',
      serviceType: 'KI-Entwicklung & LLM-Integration',
      url: 'https://skale.dev/ai-engineering/',
      areaServed: [
        { '@type': 'Country', name: 'Österreich' },
        { '@type': 'Country', name: 'Deutschland' },
      ],
      description,
      provider: { '@id': 'https://skale.dev/#organization' },
    },
  ],
};

const stack = [
  'Python', 'FastAPI', 'PostgreSQL', 'Open-Weight-LLMs',
  'Llama', 'Qwen', 'DeepSeek', 'GLM', 'RAG / Vektorindizes',
  'Agentic Workflows', 'Docker', 'Monitoring & Eval',
];

const steps = [
  {
    n: '01',
    t: 'Erstgespräch & Use-Case-Check',
    d: '30 Minuten, unverbindlich. Wir prüfen, ob Ihr Vorhaben KI-tauglich ist — und sagen es offen, wenn eine einfachere Lösung schlauer wäre.',
  },
  {
    n: '02',
    t: 'Prototyp an echten Daten',
    d: 'In wenigen Wochen ein arbeitsfähiger Prototyp auf Ihren Dokumenten und Prozessen — keine Folien, sondern etwas zum Ausprobieren.',
  },
  {
    n: '03',
    t: 'Produktion & Integration',
    d: 'Hardening, Evaluation, Schnittstellen in Ihre Systeme. Betrieben wird auf Ihrer Infrastruktur oder on-premise bei Ihnen im Haus.',
  },
  {
    n: '04',
    t: 'Betrieb & Weiterentwicklung',
    d: 'Monitoring, Modell-Updates, Kostenkontrolle. Was Ihre Mitarbeiter dabei lernen, fließt in Ihre Systeme zurück — nicht in ein Fremdmodell.',
  },
];

const faqs = [
  {
    q: 'Was kostet ein AI-Engineering-Projekt?',
    a: 'Das hängt vom Umfang ab: Ein Prototyp auf Ihren Daten ist meist nach wenigen Wochen standing. Nach dem Erstgespräch erhalten Sie eine klare Aufwands- und Kosteneinschätzung, bevor Sie sich entscheiden.',
  },
  {
    q: 'Läuft die KI auch ohne Cloud bei uns im Haus?',
    a: 'Ja. Wir betreiben Open-Weight-Modelle (Llama, Qwen, DeepSeek, GLM) auf eigener Hardware — on-premise und DSGVO-konform. Ihre Daten verlassen das Unternehmen nicht.',
  },
  {
    q: 'Unterscheidet sich AI Engineering von „KI-Beratung"?',
    a: 'Beratung endet typischerweise mit einer Empfehlung. AI Engineering liefert das arbeitsende System: Pipeline, Integration in Ihre Prozesse, Betrieb und Weiterentwicklung — produktionsreif, nicht als Folienkonzept.',
  },
  {
    q: 'Welche Modelle setzen Sie ein?',
    a: 'Vorwiegend Open-Weight-Modelle wie Llama, Qwen, DeepSeek und GLM, ergänzt um spezialisierte Vision-Modelle für Dokumente. Die Auswahl hängt von Ihrem Use Case ab — wir sind modellagnostisch.',
  },
  {
    q: 'Arbeiten Sie auch mit bestehenden Systemen zusammen?',
    a: 'Ja. Wir bauen um Ihre Prozesse herum, nicht andersherum: Anbindung an ERP, DMS, Intranet oder Ticketsysteme über definierte Schnittstellen — inklusive Zugriffskontrolle und Auditierbarkeit.',
  },
];
---

<BaseLayout title={title} description={description} path="/ai-engineering/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </Fragment>

  <div class="aie-page">
    <!-- Hero -->
    <section class="aie-hero">
      <div class="container">
        <div class="hero-badge reveal">AI Engineering</div>
        <h1 class="reveal">
          KI-Systeme, die produktiv laufen — entwickelt, integriert, betrieben.
        </h1>
        <p class="aie-sub reveal">
          AI Engineering von Skale: maßgeschneiderte LLM-Systeme für
          Unternehmen in Österreich — on-premise oder Cloud, DSGVO-konform,
          produktionsreif statt Demo.
        </p>
        <div class="hero-actions reveal">
          <a href="/#contact" class="btn btn-primary btn-lg">Erstgespräch vereinbaren</a>
          <a href="#leistungen" class="btn btn-outline">Leistungen ansehen</a>
        </div>
      </div>
    </section>

    <!-- Was ist AI Engineering -->
    <section class="section">
      <div class="container">
        <header class="section-head reveal">
          <h2 class="section-title">Was ist AI Engineering?</h2>
          <p class="section-sub">
            Die Disziplin, aus Sprachmodellen arbeitsende Systeme zu machen.
          </p>
        </header>
        <div class="aie-prose reveal">
          <p>
            AI Engineering ist die Ingenieursdisziplin hinter produktiven
            KI-Anwendungen: Sie verbindet Maschinenlernen, Software-Architektur
            und Prozesswissen zu Systemen, die im Tagesgeschäft bestehen —
            nicht nur im Demo-Video. Dazu gehören Modellauswahl und Evaluation,
            Retrieval-Pipelines über Ihre eigenen Dokumente (RAG), Integration
            in Bestandssysteme, Sicherheit und Zugriffskontrolle, Monitoring
            und Betriebsführung.
          </p>
          <p>
            Der Unterschied zur klassischen „KI-Beratung": Wir liefern kein
            Folienkonzept, sondern ein arbeitendes System in Ihren Prozessen.
            Der Unterschied zum Chatbot-Baukasten: Maßgeschneiderte Architektur
            statt Generik — mit klaren Grenzen, gemessener Qualität und
            beherrschbaren Kosten.
          </p>
        </div>
      </div>
    </section>

    <!-- Leistungen -->
    <section class="section" id="leistungen">
      <div class="container">
        <header class="section-head reveal">
          <h2 class="section-title">Leistungen</h2>
          <p class="section-sub">Sechs Bausteine — einzeln oder als Gesamtsystem.</p>
        </header>
        <div class="bento reveal">
          <article class="bento-cell">
            <span class="bento-kicker">01</span>
            <h3>LLM-Integration</h3>
            <p>Sprachmodelle in Ihre Anwendungen und Prozesse — mit Evaluation, Guardrails und Kostenkontrolle ab Tag eins.</p>
          </article>
          <article class="bento-cell">
            <span class="bento-kicker">02</span>
            <h3>RAG &amp; Dokumenten-Pipelines</h3>
            <p>Ihr Firmenwissen wird abfragbar: Ingestion, Vektorindizes, Zitierfähigkeit — über Verträge, Handbücher, Tickets.</p>
          </article>
          <article class="bento-cell">
            <span class="bento-kicker">03</span>
            <h3>On-Premise-KI</h3>
            <p>Open-Weight-Modelle (Llama, Qwen, DeepSeek, GLM) auf Ihrer Hardware. DSGVO-konform, ohne Cloud-Zwang, pro Token nie wieder zahlen.</p>
          </article>
          <article class="bento-cell">
            <span class="bento-kicker">04</span>
            <h3>Agentic Workflows</h3>
            <p>KI-Agenten, die mehrstufige Aufgaben erledigen — Recherche, Auswertung, Reporting — mit menschlicher Kontrolle an den entscheidenden Stellen.</p>
          </article>
          <article class="bento-cell">
            <span class="bento-kicker">05</span>
            <h3>KI-Automatisierung</h3>
            <p>Dokumentenverarbeitung, Klassifizierung, Extraktion mit strukturierter Ausgabe — direkt in ERP, DMS oder Ticketsystem.</p>
          </article>
          <article class="bento-cell">
            <span class="bento-kicker">06</span>
            <h3>Betrieb &amp; Weiterentwicklung</h3>
            <p>Monitoring, Modell-Updates, Eval-Regressionen, Kostensteuerung. Ein System, das besser wird, je länger es läuft.</p>
          </article>
        </div>
      </div>
    </section>

    <!-- Stack -->
    <section class="section">
      <div class="container">
        <header class="section-head reveal">
          <h2 class="section-title">Technologie</h2>
          <p class="section-sub">
            Bewährte Bausteine, modellagnostisch aufgestellt — Sie werden nicht
            an einen Anbieter gebunden.
          </p>
        </header>
        <ul class="aie-stack reveal" role="list">
          {stack.map((s) => <li>{s}</li>)}
        </ul>
      </div>
    </section>

    <!-- Prozess -->
    <section class="section">
      <div class="container">
        <header class="section-head reveal">
          <h2 class="section-title">So läuft ein Projekt</h2>
          <p class="section-sub">Vier Schritte, jeder mit klarem Ergebnis.</p>
        </header>
        <div class="bento reveal">
          {steps.map((s) => (
            <article class="bento-cell">
              <span class="bento-kicker">{s.n}</span>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </article>
          ))}
        </div>
        <p class="aie-more reveal">
          Offen ist auch, was <em>nicht</em> passt: Wenn KI nicht das richtige
          Werkzeug für Ihr Problem ist, sagen wir das im Erstgespräch.
        </p>
      </div>
    </section>

    <!-- FAQ -->
    <section class="section">
      <div class="container">
        <header class="section-head reveal">
          <h2 class="section-title">Häufige Fragen</h2>
        </header>
        <div class="faq reveal">
          {faqs.map((f) => (
            <details class="faq-item">
              <summary>
                {f.q}
                <span class="faq-icon" aria-hidden="true"></span>
              </summary>
              <p>{f.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section">
      <div class="container">
        <div class="aie-cta reveal">
          <h2>Bereit für ein Erstgespräch?</h2>
          <p>
            30 Minuten, unverbindlich, mit ehrlicher Einschätzung —
            ob AI Engineering für Ihren Fall das richtige Werkzeug ist.
          </p>
          <div class="hero-actions">
            <a href="/#contact" class="btn btn-primary btn-lg">Erstgespräch vereinbaren</a>
            <a href="/agent-coding/" class="btn btn-outline">Unsere Open-Source-Arbeit</a>
          </div>
          <p class="aie-reading">
            Weiterlesen: <a href="/blog/ki-beratung-fuer-kmu/">KI-Beratung für KMU —
            ehrlich zum KI-Einstieg</a> · <a href="/blog/on-premise-llm-selbst-hosten/">On-Premise-LLM
            selbst hosten</a>
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style is:global>
  /* page-scope styles (global classes: section/bento/faq/btn come from global.css) */
  .aie-hero { padding: 96px 0 24px; text-align: center; }
  .aie-hero h1 {
    font-size: clamp(2rem, 5vw, 3.2rem); line-height: 1.12;
    letter-spacing: -0.02em; max-width: 820px; margin: 18px auto 0;
    color: var(--text-bright);
  }
  .aie-sub { max-width: 640px; margin: 20px auto 0; color: var(--text-dim); font-size: 1.08rem; }
  .aie-hero .hero-actions { justify-content: center; }
  .aie-prose { max-width: 760px; margin: 0 auto; display: flex; flex-direction: column; gap: 14px; color: var(--text-dim); }
  .aie-prose strong, .aie-prose em { color: var(--text-bright); }
  .aie-stack {
    display: flex; flex-wrap: wrap; gap: 10px; justify-content: center;
    max-width: 760px; margin: 0 auto; padding: 0; list-style: none;
  }
  .aie-stack li {
    border: 1px solid var(--border); border-radius: 999px;
    padding: 7px 16px; font-size: 0.9rem; color: var(--text-dim);
    font-family: var(--mono);
  }
  .aie-more { text-align: center; color: var(--text-dim); margin-top: 18px; }
  .aie-cta {
    text-align: center; border: 1px solid var(--border); border-radius: 16px;
    padding: 44px 24px; background: var(--bg-card, rgba(255,255,255,0.02));
  }
  .aie-cta h2 { color: var(--text-bright); margin-bottom: 10px; }
  .aie-cta p { color: var(--text-dim); max-width: 560px; margin: 0 auto 8px; }
  .aie-cta .hero-actions { justify-content: center; }
  .aie-reading { margin-top: 18px; font-size: 0.92rem; color: var(--text-dim); }
  .aie-reading a { color: var(--text-dim); text-decoration: underline; text-underline-offset: 3px; }
  .aie-reading a:hover { color: var(--text-bright); }
</style>
