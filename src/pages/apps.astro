---
import BaseLayout from '@layouts/BaseLayout.astro';
import { apps } from '@data/apps.js';

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Startseite', item: 'https://skale.dev/' },
        { '@type': 'ListItem', position: 2, name: 'Apps & Tools', item: 'https://skale.dev/apps/' },
      ],
    },
    {
      '@type': 'CollectionPage',
      name: 'Apps & Tools – skale.dev',
      url: 'https://skale.dev/apps/',
      description: 'Kostenlose Web-Tools von skale.dev: Firmenindex Österreich, throway, PDF Annotator, ChopDok.',
      isPartOf: { '@id': 'https://skale.dev/#website' },
      mainEntity: {
        '@type': 'ItemList',
        itemListElement: apps.map((a, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          item: {
            '@type': 'SoftwareApplication',
            name: a.name,
            applicationCategory: 'BusinessApplication',
            operatingSystem: 'Web',
            url: new URL(a.href, 'https://skale.dev/').toString(),
            description: a.desc,
            offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
            publisher: { '@id': 'https://skale.dev/#organization' },
          },
        })),
      },
    },
  ],
};

const title = 'Apps & Tools – skale.dev';
const description = 'Apps und Tools von skale.dev: Firmenindex Österreich, throway, PDF Annotator, ChopDok. Kostenlose Web-Tools, direkt im Browser.';

// Diagonal "open" arrow shown next to each card title
const arrow = '<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 11.5L11.5 4.5"/><path d="M5.5 4.5h6v6"/></svg>';
---

<BaseLayout title={title} description={description} path="/apps/">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />
  </Fragment>

  <section class="apps-page">
    <div class="container">
      <a href="/" class="apps-back">← Zurück zur Startseite</a>

      <header class="apps-head">
        <h1>Apps &amp; Tools</h1>
        <p>Kostenlose Web-Tools, direkt im Browser. Keine Anmeldung, kein Setup.</p>
      </header>

      <div class="app-grid">
        {apps.map((a) => (
          <a href={a.href} class="app-card">
            <div class="app-shot"><img src={a.shot} alt={a.alt} width="1280" height="800" loading="lazy" /></div>
            <div class="app-body">
              <div class="app-name-row">
                <span class="app-name">{a.name}</span>
                <span class="app-arrow" aria-hidden="true"><Fragment set:html={arrow} /></span>
              </div>
              <p class="app-desc">{a.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .apps-page { padding: 120px 0 80px; }
  .apps-page .container { max-width: 960px; }

  .apps-back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.9rem;
    margin-bottom: 2rem;
    transition: color 0.2s;
  }
  .apps-back:hover { color: var(--red); }

  .apps-head h1 {
    font-size: 2.4rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text-bright);
    letter-spacing: -0.5px;
  }
  .apps-head p {
    font-size: 1.1rem;
    color: var(--text-dim);
    max-width: 540px;
    line-height: 1.6;
  }

  .app-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 3rem;
  }
  @media (max-width: 720px) {
    .app-grid { grid-template-columns: 1fr; }
  }

  .app-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s, background 0.2s;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
  }
  .app-card:hover {
    border-color: rgba(229,57,53,0.35);
    background: var(--bg-card-hover);
    transform: translateY(-2px);
  }
  .app-card:focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }

  /* source shots are 1280×800 (16:10), so this shows them undistorted */
  .app-shot {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: #111;
  }
  .app-shot img {
    width: 100%; height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0.85;
    transition: opacity 0.2s;
    display: block;
  }
  .app-card:hover .app-shot img { opacity: 1; }

  .app-body { padding: 18px 20px 20px; min-width: 0; }
  .app-name-row {
    display: flex; align-items: center; justify-content: space-between;
    gap: 10px; margin-bottom: 6px;
  }
  .app-name { font-size: 1.05rem; font-weight: 700; color: var(--text-bright); letter-spacing: -0.01em; }
  .app-arrow { color: var(--text-faint); flex-shrink: 0; transition: color 0.2s, transform 0.2s; display: inline-flex; }
  .app-arrow svg { width: 14px; height: 14px; }
  .app-card:hover .app-arrow {
    color: var(--red-bright);
    transform: translate(2px, -2px);
  }
  .app-desc { font-size: 0.88rem; color: var(--text); line-height: 1.55; }
</style>
